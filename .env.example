# Supabase-compatible Postgres (local Docker by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Optional PostgREST / Supabase client keys (server primarily uses DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (mock is default; required for keyless demo)
LLM_PROVIDER=mock            # mock | openai
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000

# Jira (optional; live mode only when all provided)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Runtime
WORKFLOWPILOT_DEMO_MODE=true
WORKFLOWPILOT_REVIEW_CONFIDENCE_THRESHOLD=0.6
